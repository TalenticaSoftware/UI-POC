<div class="flex flex-col mt-10" id="filterBtns">
  <!-- Filter Buttons Container -->
  <div class="flex gap-2">
    {{#each filters}}
      <!-- Iterate through each filter option -->
      <button
        {{!-- onclick="this.querySelector('.spinner').classList.remove('hidden')" --}}
        hx-get="/?filter={{this.filterName}}"  <!-- Makes GET request with filter parameter -->
        hx-target="body"                       <!-- Updates the entire body with response -->
        hx-push-url="true"                     <!-- Updates URL in browser history -->
        hx-boost="true"                        <!-- Enables HTMX page transitions -->
        hx-swap="transition:true"              <!-- Enables smooth transition effects -->
        
        <!-- Dynamic classes for styling -->
        class="border-2 border-indigo-500 p-4 rounded-lg w-1/2 uppercase font-bold 
               transition-all hover:bg-indigo-400  hover:scale-105 text-center cursor-pointer 
               {{#ifEqual @root.selectedFilter this.filterName}} bg-indigo-500{{/ifEqual}}"
      >
        <!-- Button content -->
        <!-- Shows filter name and count of todos in that category -->
        <span class="label">{{this.filterName}} ({{this.count}})</span>

        <!-- Loading indicator that shows during HTMX requests -->
        <img 
          src="assets/circular_loader.svg" 
          class="my-indicator h-5 w-auto mx-auto" 
          alt="Loading..."
        />
      </button>
    {{/each}}
  </div>

  <!-- Display the "no todos" partial if noTodos is false -->
  {{#unless noTodos}}
    {{>noTodo}}                                         
  {{/unless}}
</div>