<!-- Todo Input Form with HTMX attributes -->
<form
  hx-post="/todos"                         <!-- Send POST request to /todos endpoint -->
  hx-target="body"                         <!-- Update entire body with response -->
  hx-swap="innerHTML transition:true"      <!-- Swap content with transition effect -->
  hx-on::response-error="handleDuplicateError(event)"  <!-- Handle duplicate todo errors -->
  oninput="document.getElementById('addTodoButton').disabled = !this.todo.value.trim()"  <!-- Disable button if input is empty -->
>
  <!-- Hidden input to maintain current filter state -->
  <input type="hidden" name="filter" value="{{this.selectedFilter}}" />

  <!-- Todo Input Field -->
  <input
    type="text"
    name="todo"
    id="todoInput"
    required                               <!-- Make field required -->
    minlength="5"                          <!-- Minimum 5 characters required -->
    placeholder="What's in your mind?"
    class="block w-full rounded-lg p-4 text-black text-2xl"
    autofocus                              <!-- Focus input when page loads -->
  />

  <!-- Add Todo Button -->
  <button
    id="addTodoButton"
    hx-disabled-elt="this"                 <!-- HTMX will disable this during requests -->
    type="submit"
    class="block w-1/2 mx-auto p-2 rounded-lg text-xl mt-5 bg-amber-500 uppercase font-bold 
           hover:bg-amber-600 transition-all hover:shadow-lg hover:translate-y-1 
           disabled:bg-gray-400 disabled:cursor-not-allowed"
    disabled                               <!-- Initially disabled until input has value -->
  >
    Add Todo
  </button>

  <!-- Loading Indicator -->
  <div
    id="request-indicator"
    class="flex items-center my-indicator justify-center my-8"
  >
    <img
      src="assets/bars.svg"
      alt="Loading indicator"
      class="h-12 w-12 mx-auto"
    />
  </div>
</form>

<!-- JavaScript for Error Handling -->
<script>
  // Function to handle duplicate todo errors
  function handleDuplicateError(event) {
    // Get error message from server response
    const errorMessage = event.detail.xhr.responseText;
    // Get reference to input field
    const inputField = document.getElementById("todoInput");
    
    // Show error message to user
    alert(errorMessage);
    
    // Reset form state
    inputField.value = "";                 // Clear input field
    document.getElementById("addTodoButton").disabled = true;  // Disable button
  }
</script>